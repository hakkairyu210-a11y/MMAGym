<div class="blazor-live-stat-card card bg-dark border border-danger border-opacity-50 rounded-4 p-4 shadow-sm text-light mb-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-danger p-2"><i class="fas fa-bolt"></i></span>
            <div>
                <h5 class="fw-bold text-white mb-0">Blazor Server Interactive Widget</h5>
                <span class="text-xs text-white-50">Tương tác thời gian thực realtime bằng C# Blazor Server</span>
            </div>
        </div>
        <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50">
            <i class="fas fa-signal me-1"></i> Live Connection
        </span>
    </div>

    <div class="row g-3 text-center my-2">
        <div class="col-md-6">
            <div class="p-3 bg-black rounded-3 border border-secondary border-opacity-25">
                <span class="text-xs text-uppercase text-white-50 d-block mb-1">Số lượt Check-in hôm nay</span>
                <div class="fs-2 fw-black text-danger">@checkInCount</div>
                <div class="d-flex justify-content-center gap-2 mt-2">
                    <button class="btn btn-sm btn-outline-danger px-3" @onclick="IncrementCheckIn">
                        <i class="fas fa-plus me-1"></i> Check-in +1
                    </button>
                    <button class="btn btn-sm btn-outline-secondary px-3" @onclick="ResetCheckIn">
                        Reset
                    </button>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="p-3 bg-black rounded-3 border border-secondary border-opacity-25">
                <span class="text-xs text-uppercase text-white-50 d-block mb-1">Doanh thu giả lập nhanh</span>
                <div class="fs-2 fw-black text-success">@estimatedRevenue.ToString("N0") VNĐ</div>
                <div class="d-flex justify-content-center gap-2 mt-2">
                    <button class="btn btn-sm btn-outline-success px-3" @onclick="AddSubscription">
                        <i class="fas fa-cart-plus me-1"></i> Gói tập mới +2M
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private int checkInCount = 142;
    private decimal estimatedRevenue = 385000000;

    private void IncrementCheckIn()
    {
        checkInCount++;
    }

    private void ResetCheckIn()
    {
        checkInCount = 0;
    }

    private void AddSubscription()
    {
        estimatedRevenue += 2000000;
    }
}
