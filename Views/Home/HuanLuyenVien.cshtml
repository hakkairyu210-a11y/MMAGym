@model List<MMA.Models.TrainerModel>
@{
    ViewData["Title"] = "Đội Nũ Huấn Luyện Viên - MMA Sài Gòn";
}

<!-- Entry Banner Section -->
<section class="entry-banner">
    <div class="container">
        <h1 class="entry-title">Đội Nũ Huấn Luyện Viên</h1>
        <div class="breadcrumb-area">
            <a href="/">MMA Sài Gòn</a>
            <span class="dvdr">-</span>
            <span class="current-item">Huấn Luyện Viên</span>
        </div>
    </div>
</section>

<!-- Trainers Grid Section -->
<section class="section-padding bg-black text-white">
    <div class="container">
        <div class="text-center mb-5">
            <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-50 text-xs px-3 py-1.5 rounded-pill mb-2">ĐỘI NGŨ CHUYÊN NGIỆP</span>
            <h2 class="display-6 fw-black text-white">Huấn Luyện Viên Hàng Đầu MMA Sài Gòn</h2>
            <p class="text-white-50 text-sm max-w-xl mx-auto">Đội ngũ HLV có chứng chỉ quốc tế, giàu kinh nghiệm thi đấu và tâm huyết đồng hành cùng mục tiêu của bạn.</p>
        </div>

        <div class="row g-4">
            @foreach (var trainer in Model)
            {
                <div class="col-lg-3 col-md-6">
                    <div class="card bg-dark border-secondary border-opacity-25 rounded-4 p-4 text-center h-100 shadow-lg hover-border-danger transition-all">
                        <div class="position-relative d-inline-block mx-auto mb-3">
                            <img src="@trainer.ImageUrl" class="rounded-circle border border-3 border-danger p-1 shadow" style="width: 140px; height: 140px; object-fit: cover;" alt="@trainer.Name">
                            <span class="position-absolute bottom-0 end-0 badge bg-danger text-white rounded-circle p-1.5 border border-2 border-dark" title="Đã chứng nhận">
                                <i class="fas fa-check text-xs"></i>
                            </span>
                        </div>
                        <h4 class="fw-bold text-white mb-1 fs-5">@trainer.Name</h4>
                        <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-50 text-xs mb-2">@trainer.Role</span>
                        <div class="text-xs text-warning fw-bold mb-3">
                            <i class="fas fa-award me-1"></i>@trainer.ExperienceYears Năm Kinh Nghiệm
                        </div>
                        
                        <div class="d-flex flex-column gap-2 mt-auto">
                            <a href="/huan-luyen-vien/@trainer.Id" class="btn btn-danger btn-sm text-xs py-2 fw-bold shadow-sm">
                                <i class="fas fa-id-card me-1"></i> Xem Chi Tiết HLV
                            </a>
                            <button type="button" class="btn btn-outline-secondary btn-sm text-xs py-1.5 text-white-50"
                                    onclick="showTrainerDetail('@trainer.Name', '@trainer.Role', '@trainer.ExperienceYears', '@trainer.Certificates', '@trainer.Bio', '@trainer.Specialties', '@trainer.Id')">
                                <i class="fas fa-eye me-1"></i> Xem Nhanh
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Modal Xem Hồ Sơ HLV -->
<div class="modal fade" id="trainerDetailModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content modal-content-dark">
            <div class="modal-header modal-header-dark py-3">
                <h5 class="modal-title fw-bold text-white" id="mTrainerName">Hồ Sơ Huấn Luyện Viên</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <span class="badge bg-danger text-white mb-2" id="mTrainerRole"></span>
                <p class="text-white-50 mb-3" id="mTrainerBio"></p>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <div class="p-3 bg-black rounded-3 border border-secondary border-opacity-25">
                            <div class="text-xs text-white-50 uppercase fw-bold">Kinh Nghiệm</div>
                            <div class="text-warning fw-bold fs-5" id="mTrainerExp"></div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-black rounded-3 border border-secondary border-opacity-25">
                            <div class="text-xs text-white-50 uppercase fw-bold">Chuyên Môn</div>
                            <div class="text-info fw-bold text-sm" id="mTrainerSpecs"></div>
                        </div>
                    </div>
                </div>
                <div class="p-3 bg-black rounded-3 border border-secondary border-opacity-25">
                    <div class="text-xs text-white-50 uppercase fw-bold mb-1">Bằng Cấp & Chứng Chỉ</div>
                    <div class="text-success fw-bold text-sm" id="mTrainerCerts"></div>
                </div>
            </div>
            <div class="modal-footer modal-footer-dark">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <a id="mTrainerFullPageBtn" href="#" class="btn btn-outline-danger text-uppercase fw-bold"><i class="fas fa-id-card me-1"></i> Trang Chi Tiết</a>
                <a href="/#register-section" class="btn btn-danger text-uppercase fw-bold"><i class="fas fa-dumbbell me-1"></i> Đăng Ký Tập Cùng HLV</a>
            </div>
        </div>
    </div>
</div>

<script>
    function showTrainerDetail(name, role, exp, certs, bio, specs, id) {
        document.getElementById('mTrainerName').innerText = name;
        document.getElementById('mTrainerRole').innerText = role;
        document.getElementById('mTrainerExp').innerText = exp + ' Năm Kinh Nghiệm';
        document.getElementById('mTrainerCerts').innerText = certs;
        document.getElementById('mTrainerBio').innerText = bio;
        document.getElementById('mTrainerSpecs').innerText = specs;
        if (id) {
            document.getElementById('mTrainerFullPageBtn').href = '/huan-luyen-vien/' + id;
        }
        var myModal = new bootstrap.Modal(document.getElementById('trainerDetailModal'));
        myModal.show();
    }
</script>
