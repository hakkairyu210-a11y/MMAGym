@model MMA.Models.RegisterViewModel
@{
    ViewData["Title"] = "Giới thiệu";
}

<!-- Entry Banner Section -->
<section class="entry-banner">
    <div class="container">
        <h1 class="entry-title">Giới thiệu</h1>
        <div class="breadcrumb-area">
            <a href="#">MMA Sài Gòn</a>
            <span class="dvdr">-</span>
            <span class="current-item">Giới thiệu</span>
        </div>
    </div>
</section>

<!-- Section 1: Chúng tôi là ai -->
<section class="section-padding">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <div class="slant-img-container">
                    <img src="https://fitbox.vn/wp-content/uploads/2026/06/Fitbox-gioi-thieu.png" alt="MMA Giới thiệu">
                </div>
            </div>
            <div class="col-lg-6">
                <span class="subtitle-badge">Chúng tôi là ai</span>
                <h2 class="section-heading-title">Chúng Tôi Kiến Tạo <br><span class="text-danger">Thể Chất – Ý Chí – Phong Cách Sống</span></h2>
                <p class="text-justify mb-4">
                    <strong>MMA</strong> là mô hình phòng tập hiện đại, chuyên sâu về <strong>Boxing</strong>, <strong>Muay Thai</strong> và <strong>Fitness</strong> — với định hướng lấy trải nghiệm thực và kết quả của hội viên làm trung tâm. <strong>MMA</strong> không chỉ là nơi tập luyện, mà là nơi giúp hội viên kiến tạo lại thể chất – ý chí – phong cách sống thông qua hành trình rèn luyện bền vững.
                </p>
                <ul class="custom-list mb-4">
                    <li><strong>Hệ sinh thái toàn diện:</strong> Gym, Boxing, Muay Thai, Kickboxing, Yoga, Dance, Aerobic, Zumba & EMS</li>
                    <li>Tất cả HLV lớp Võ đều là <strong>Vận Động Viên Quốc Gia</strong></li>
                    <li>Không gian rộng từ <strong>700m² đến hơn 2.500m²</strong>, trang thiết bị hiện đại</li>
                    <li><strong>Cam kết:</strong> Không chèo kéo, không gian dối — chỉ có kết quả thật</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<!-- Section 2: Tại sao chọn MMA -->
<section class="section-padding section-bg-tint">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6 order-2 order-lg-1">
                <span class="subtitle-badge">Tại sao chọn MMA</span>
                <h2 class="section-heading-title">MMA Không Bán "Gói Tập" <br><span class="text-danger">Chúng Tôi Bán Kết Quả Thật</span></h2>
                <p class="text-justify mb-4">
                    <strong>MMA</strong> không phải phòng gym thông thường. Chúng tôi là <strong>hệ sinh thái sức khỏe toàn diện</strong> đầu tiên tại Sài Gòn — kết hợp sức mạnh của <strong>Fitness</strong>, máu lửa của <strong>Võ thuật</strong> và sự cân bằng của <strong>Yoga</strong>.
                </p>
                <ul class="custom-list mb-4">
                    <li><strong>🥊 Sản phẩm khác biệt:</strong> Gym + Boxing/Muay Thai chuyên sâu — vừa có cơ sở vật chất hiện đại, vừa có không khí kỷ luật võ thuật.</li>
                    <li><strong>💬 Sale là người đồng hành:</strong> Không chèo kéo, không áp lực doanh số — chỉ lắng nghe và tư vấn đúng nhu cầu thật của bạn.</li>
                    <li><strong>📋 Minh bạch & Linh hoạt:</strong> Bảng giá niêm yết rõ ràng, kỳ hạn 1–12 tháng, cam kết tuyệt đối không gán gói hay mập mờ tài chính.</li>
                </ul>
                <a href="#register-section" class="btn btn-danger consult-btn text-uppercase">
                    Liên hệ tư vấn <i class="fas fa-arrow-right ms-2"></i>
                </a>
            </div>
            <div class="col-lg-6 order-1 order-lg-2">
                <div class="slant-img-container">
                    <img src="https://fitbox.vn/wp-content/uploads/2026/05/Thu-vien-bai-tap-moi-Fitbox.png" alt="Thư viện bài tập MMA">
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Section 3: Stat Boxes Grid -->
<section class="section-padding">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-4 col-md-6">
                <div class="stat-box-card">
                    <div class="stat-box-icon"><i class="fas fa-building"></i></div>
                    <div class="stat-box-content">
                        <h3>6 Chi Nhánh</h3>
                        <p>Q1, Q3, Q6, Q8, Phú Nhuận, Tân Phú</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="stat-box-card">
                    <div class="stat-box-icon"><i class="fas fa-running"></i></div>
                    <div class="stat-box-content">
                        <h3>9+ Bộ Môn</h3>
                        <p>Gym, Boxing, Muay Thai, Yoga, Dance, EMS...</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="stat-box-card">
                    <div class="stat-box-icon"><i class="fas fa-place-of-worship"></i></div>
                    <div class="stat-box-content">
                        <h3>700–2.500m²</h3>
                        <p>Không gian rộng, thiết bị chuẩn quốc tế</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="stat-box-card">
                    <div class="stat-box-icon"><i class="fas fa-user-ninja"></i></div>
                    <div class="stat-box-content">
                        <h3>100% HLV VĐV</h3>
                        <p>Tất cả HLV lớp Võ là VĐV Quốc Gia</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="stat-box-card">
                    <div class="stat-box-icon"><i class="fas fa-dumbbell"></i></div>
                    <div class="stat-box-content">
                        <h3>Tập Thử Miễn Phí</h3>
                        <p>Buổi đầu tiên hoàn toàn miễn phí</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="stat-box-card">
                    <div class="stat-box-icon"><i class="fas fa-handshake"></i></div>
                    <div class="stat-box-content">
                        <h3>Cam Kết Minh Bạch</h3>
                        <p>Bảng giá rõ ràng, không chèo kéo</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Section 4: PT Swiper Slider -->
<section class="section-padding section-bg-dark text-white">
    <div class="container">
        <div class="text-center mb-5">
            <span class="subtitle-badge text-danger">Đội ngũ huấn luyện viên</span>
            <h2 class="text-white section-heading-title">PT Chuyên Nghiệp Đồng Hành</h2>
            <p class="text-muted max-width-600 mx-auto">
                Đội ngũ huấn luyện viên giàu kinh nghiệm, chuyên môn cao và tận tâm luôn sẵn sàng hỗ trợ bạn chinh phục mọi thử thách hình thể.
            </p>
        </div>
        <div class="carousel-wrapper">
            <!-- Swiper -->
            <div class="swiper pt-swiper">
                <div class="swiper-wrapper">
                    <div class="swiper-slide">
                        <img src="https://fitbox.vn/wp-content/uploads/2026/06/PT-6.png" alt="PT 6">
                    </div>
                    <div class="swiper-slide">
                        <img src="https://fitbox.vn/wp-content/uploads/2026/06/PT-5.png" alt="PT 5">
                    </div>
                    <div class="swiper-slide">
                        <img src="https://fitbox.vn/wp-content/uploads/2026/06/PT-4.png" alt="PT 4">
                    </div>
                    <div class="swiper-slide">
                        <img src="https://fitbox.vn/wp-content/uploads/2026/06/PT-3.png" alt="PT 3">
                    </div>
                </div>
                <!-- Navigation -->
                <div class="carousel-btn-prev pt-swiper-button-prev"><i class="fas fa-chevron-left"></i></div>
                <div class="carousel-btn-next pt-swiper-button-next"><i class="fas fa-chevron-right"></i></div>
                <!-- Pagination -->
                <div class="swiper-pagination pt-swiper-pagination text-center mt-4"></div>
            </div>
        </div>
    </div>
</section>

<!-- Section 5: Disciplines Explorer -->
<section class="section-padding">
    <div class="container">
        <div class="text-center mb-5">
            <span class="subtitle-badge">Đa dạng các bộ môn</span>
            <h2 class="section-heading-title">Khám phá các bộ môn bạn yêu thích</h2>
            <p class="text-muted max-width-600 mx-auto">
                Hệ thống lớp học tại MMA được thiết kế khoa học, giúp bạn tìm thấy niềm vui luyện tập và nhanh chóng đạt mục tiêu thể hình mong muốn.
            </p>
        </div>

        <div class="row g-4">
            <!-- Class 1 -->
            <div class="col-lg-4 col-md-6">
                <div class="class-grid-card">
                    <div class="class-card-img-wrap">
                        <img src="https://fitbox.vn/wp-content/uploads/2026/05/dance-cover.png" alt="Dance Cover">
                    </div>
                    <div class="class-card-overlay"></div>
                    <div class="class-card-info">
                        <div class="class-card-icon"><i class="fas fa-music"></i></div>
                        <h3 class="class-card-title">Dance Cover</h3>
                        <p class="class-card-text">Dance Cover tại MMA là lớp học nhảy sôi động, giúp đốt calo hiệu quả và giải phóng năng lượng cơ thể.</p>
                        <div class="class-card-schedule">Friday: 1:00 pm</div>
                    </div>
                </div>
            </div>
            <!-- Class 2 -->
            <div class="col-lg-4 col-md-6">
                <div class="class-grid-card">
                    <div class="class-card-img-wrap">
                        <img src="https://fitbox.vn/wp-content/uploads/2026/05/personal-trainer.png" alt="Personal Trainer">
                    </div>
                    <div class="class-card-overlay"></div>
                    <div class="class-card-info">
                        <div class="class-card-icon"><i class="fas fa-dumbbell"></i></div>
                        <h3 class="class-card-title">Personal Trainer</h3>
                        <p class="class-card-text">Lộ trình thiết kế riêng biệt 1-kèm-1 cùng huấn luyện viên để đạt kết quả tối ưu trong thời gian ngắn nhất.</p>
                        <div class="class-card-schedule">Friday: 10:00 am</div>
                    </div>
                </div>
            </div>
            <!-- Class 3 -->
            <div class="col-lg-4 col-md-6">
                <div class="class-grid-card">
                    <div class="class-card-img-wrap">
                        <img src="https://fitbox.vn/wp-content/uploads/2026/05/zumba.png" alt="Zumba">
                    </div>
                    <div class="class-card-overlay"></div>
                    <div class="class-card-info">
                        <div class="class-card-icon"><i class="fas fa-fire"></i></div>
                        <h3 class="class-card-title">Zumba</h3>
                        <p class="class-card-text">Vũ điệu Zumba cuồng nhiệt đốt cháy năng lượng, rèn luyện tim mạch trên nền nhạc Latin sôi động.</p>
                        <div class="class-card-schedule">Saturday: 9:00 am</div>
                    </div>
                </div>
            </div>
            <!-- Class 4 -->
            <div class="col-lg-4 col-md-6">
                <div class="class-grid-card">
                    <div class="class-card-img-wrap">
                        <img src="https://fitbox.vn/wp-content/uploads/2026/05/yoga-an.png" alt="Yoga Ấn">
                    </div>
                    <div class="class-card-overlay"></div>
                    <div class="class-card-info">
                        <div class="class-card-icon"><i class="fas fa-leaf"></i></div>
                        <h3 class="class-card-title">Yoga Ấn</h3>
                        <p class="class-card-text">Kết nối thân tâm, tăng cường sự dẻo dai và đẩy lùi stress cùng các Master Yoga hàng đầu từ Ấn Độ.</p>
                        <div class="class-card-schedule">Monday: 9:00 am</div>
                    </div>
                </div>
            </div>
            <!-- Class 5 -->
            <div class="col-lg-4 col-md-6">
                <div class="class-grid-card">
                    <div class="class-card-img-wrap">
                        <img src="https://fitbox.vn/wp-content/uploads/2026/05/cycling.png" alt="Cycling">
                    </div>
                    <div class="class-card-overlay"></div>
                    <div class="class-card-info">
                        <div class="class-card-icon"><i class="fas fa-bicycle"></i></div>
                        <h3 class="class-card-title">Cycling</h3>
                        <p class="class-card-text">Đạp xe trong nhà đầy năng lượng, cải thiện sức bền tim mạch và đốt mỡ vượt trội.</p>
                        <div class="class-card-schedule">Wednesday: 9:00 am</div>
                    </div>
                </div>
            </div>
            <!-- Class 6 -->
            <div class="col-lg-4 col-md-6">
                <div class="class-grid-card">
                    <div class="class-card-img-wrap">
                        <img src="https://fitbox.vn/wp-content/uploads/2026/05/muay-thai.png" alt="Muay Thái">
                    </div>
                    <div class="class-card-overlay"></div>
                    <div class="class-card-info">
                        <div class="class-card-icon"><i class="fas fa-user-ninja"></i></div>
                        <h3 class="class-card-title">Muay Thái</h3>
                        <p class="class-card-text">Sức mạnh, tốc độ và bản lĩnh võ thuật thực chiến. Đốt cháy tới 800 calo mỗi giờ tập luyện.</p>
                        <div class="class-card-schedule">Sunday: 6:00 pm</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Section 6: Facilities Swiper Slider -->
<section class="section-padding section-bg-dark text-white">
    <div class="container">
        <div class="text-center mb-5">
            <span class="subtitle-badge text-danger">Hệ thống cơ sở vật chất</span>
            <h2 class="text-white section-heading-title">MMA đảm bảo trang thiết bị hiện đại</h2>
            <p class="text-muted max-width-600 mx-auto">
                MMA đầu tư trang thiết bị chuẩn quốc tế — để mỗi hội viên có trải nghiệm tập luyện tốt nhất mỗi ngày.
            </p>
        </div>
        <div class="carousel-wrapper">
            <!-- Swiper -->
            <div class="swiper facilities-swiper">
                <div class="swiper-wrapper">
                    <div class="swiper-slide">
                        <img src="https://fitbox.vn/wp-content/uploads/2026/06/Trang-thiet-bi-Fitbox-1.png" alt="Trang thiết bị 1">
                    </div>
                    <div class="swiper-slide">
                        <img src="https://fitbox.vn/wp-content/uploads/2026/06/Trang-thiet-bi-Fitbox-2.png" alt="Trang thiết bị 2">
                    </div>
                    <div class="swiper-slide">
                        <img src="https://fitbox.vn/wp-content/uploads/2026/06/Trang-thiet-bi-Fitbox-3-1.png" alt="Trang thiết bị 3">
                    </div>
                    <div class="swiper-slide">
                        <img src="https://fitbox.vn/wp-content/uploads/2026/06/Trang-thiet-bi-Fitbox-4.png" alt="Trang thiết bị 4">
                    </div>
                    <div class="swiper-slide">
                        <img src="https://fitbox.vn/wp-content/uploads/2026/06/Trang-thiet-bi-Fitbox-5.png" alt="Trang thiết bị 5">
                    </div>
                    <div class="swiper-slide">
                        <img src="https://fitbox.vn/wp-content/uploads/2026/06/Trang-thiet-bi-Fitbox-6-1.png" alt="Trang thiết bị 6">
                    </div>
                    <div class="swiper-slide">
                        <img src="https://fitbox.vn/wp-content/uploads/2026/06/Trang-thiet-bi-Fitbox-7-1.png" alt="Trang thiết bị 7">
                    </div>
                </div>
                <!-- Navigation -->
                <div class="carousel-btn-prev fac-swiper-button-prev"><i class="fas fa-chevron-left"></i></div>
                <div class="carousel-btn-next fac-swiper-button-next"><i class="fas fa-chevron-right"></i></div>
                <!-- Pagination -->
                <div class="swiper-pagination fac-swiper-pagination text-center mt-4"></div>
            </div>
        </div>
    </div>
</section>

<!-- Section 7: Info Section (Promotions) -->
<section class="section-padding section-bg-tint">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-5">
                <div class="promo-banner-wrap text-center">
                    <img src="https://fitbox.vn/wp-content/uploads/2026/06/Khuyen-mai-hoi-vien.png" alt="Khuyến mãi hội viên MMA" class="img-fluid rounded shadow-sm max-width-100">
                </div>
            </div>
            <div class="col-lg-7">
                <div class="promo-box-grid">
                    <div class="promo-info-card">
                        <h4 class="promo-info-title">Không Chèo Kéo, Không Áp Lực</h4>
                        <p class="promo-info-text">MMA cam kết môi trường tư vấn minh bạch — nhân viên lắng nghe và giải quyết đúng nhu cầu thật của bạn.</p>
                    </div>
                    <div class="promo-info-card">
                        <h4 class="promo-info-title">Bảng Giá Niêm Yết Rõ Ràng</h4>
                        <p class="promo-info-text">Giá công khai, không phát sinh ẩn — bạn biết chính xác mình đang trả cho điều gì trước khi ký hợp đồng.</p>
                    </div>
                    <div class="promo-info-card">
                        <h4 class="promo-info-title">Linh Hoạt 1–12 Tháng</h4>
                        <p class="promo-info-text">Nhiều gói tập đa dạng kỳ hạn — phù hợp từng mức độ cam kết và ngân sách của mỗi hội viên.</p>
                    </div>
                    <div class="promo-info-card">
                        <h4 class="promo-info-title">Đánh Giá Thể Trạng Miễn Phí</h4>
                        <p class="promo-info-text">Buổi đầu tiên hoàn toàn miễn phí — đo chỉ số cơ thể, tư vấn mục tiêu và xây dựng lộ trình cá nhân hóa.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Section 8: Registration Form & Countdown -->
<section class="section-padding register-section-bg" id="register-section">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <span class="subtitle-badge text-danger">Trở thành hội viên</span>
                <h2 class="text-white section-heading-title">Đăng kí để nhận ngay ưu đãi</h2>
                <p class="text-white-50 mb-4">
                    Ưu đãi có thời hạn dành riêng cho hội viên mới — đăng ký ngay để nhận buổi tập thử miễn phí và tư vấn lộ trình cá nhân hoá từ HLV MMA.
                </p>

                <!-- Countdown Timer -->
                <div class="countdown-wrapper">
                    <div class="countdown-box">
                        <span class="countdown-number" id="cd-days">00</span>
                        <span class="countdown-label">Days</span>
                    </div>
                    <div class="countdown-box">
                        <span class="countdown-number" id="cd-hours">00</span>
                        <span class="countdown-label">Hours</span>
                    </div>
                    <div class="countdown-box">
                        <span class="countdown-number" id="cd-mins">00</span>
                        <span class="countdown-label">Minutes</span>
                    </div>
                    <div class="countdown-box">
                        <span class="countdown-number" id="cd-secs">00</span>
                        <span class="countdown-label">Seconds</span>
                    </div>
                </div>
                
                <div class="text-center text-lg-start d-none d-lg-block mt-5">
                    <img src="https://fitbox.vn/wp-content/uploads/2026/05/PT-7.png" alt="PT MMA" class="img-fluid rounded" style="max-height: 250px;">
                </div>
            </div>
            
            <div class="col-lg-6">
                <div class="registration-card">
                    <h3 class="text-white mb-4 text-uppercase text-center">Form Đăng Ký</h3>
                    <form asp-controller="Home" asp-action="GioiThieu" method="POST">
                        
                        <div class="mb-3">
                            <input asp-for="Name" class="form-control" placeholder="Họ và tên *">
                            <span asp-validation-for="Name" class="field-validation-error"></span>
                        </div>

                        <div class="mb-3">
                            <input asp-for="Email" class="form-control" type="email" placeholder="Địa chỉ Email *">
                            <span asp-validation-for="Email" class="field-validation-error"></span>
                        </div>

                        <div class="mb-3">
                            <input asp-for="Phone" class="form-control" placeholder="Số điện thoại *">
                            <span asp-validation-for="Phone" class="field-validation-error"></span>
                        </div>

                        <div class="mb-3">
                            <select asp-for="Age" class="form-select">
                                <option value="">Độ tuổi</option>
                                <option value="18-25">18-25</option>
                                <option value="25-30">25-30</option>
                                <option value="31-40">31-40</option>
                                <option value="41-50">41-50</option>
                                <option value="50-60">50-60</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <select asp-for="SelectedClass" class="form-select">
                                <option value="">Chọn bộ môn</option>
                                <option value="MMA - Mixed Martial Arts">MMA - Võ Thuật Tự Do</option>
                                <option value="Boxing">Boxing Chuyên Sâu</option>
                                <option value="Muay Thai">Muay Thái Võ Thuật</option>
                                <option value="Body Building">Body Building / Gym</option>
                                <option value="Yoga Training">Yoga Trị Liệu</option>
                                <option value="Fitness Training">Fitness & Thể Lực</option>
                            </select>
                        </div>

                        <button type="submit" class="btn btn-submit">Đăng ký ngay</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Form submission custom toast notification -->
@if (TempData["FormSuccess"] != null && (bool?)TempData["FormSuccess"] == true)
{
    <div class="toast-container-custom" id="toastSuccess">
        <div class="toast-success-custom">
            <i class="fas fa-check-circle fs-4 text-success"></i>
            <div>
                <strong>Đăng ký thành công!</strong> Cảm ơn @TempData["SubmittedName"] đã đăng ký. HLV MMA sẽ liên hệ tư vấn sớm nhất.
            </div>
        </div>
    </div>
}
