@section Scripts {
<script>
    @if (TempData["FormSuccess"] != null && (bool)TempData["FormSuccess"] && TempData["PaymentMethod"]?.ToString() == "MomoOnline")
    {
        <text>
        document.addEventListener('DOMContentLoaded', function() {
            var momoModal = new bootstrap.Modal(document.getElementById('onlinePaymentModal'));
            momoModal.show();
        });
        </text>
    }

    function toggleRegType(type) {
        var optPackages = document.getElementById('optGroupPackages');
        var optClasses = document.getElementById('optGroupClasses');
        var select = document.getElementById('selectedClassSelect');

        if (type === 'package') {
            if (optPackages) optPackages.style.display = '';
            if (optClasses) optClasses.style.display = 'none';
            if (select) select.value = "Gói 12 Tháng (1 Năm)";
        } else {
            if (optPackages) optPackages.style.display = 'none';
            if (optClasses) optClasses.style.display = '';
            if (select) select.value = "MMA - Mixed Martial Arts";
        }
    }

    function showClassDetail(title, desc, calories, audience, benefits, schedule, trainer) {
        document.getElementById('mClassTitle').innerText = title;
        document.getElementById('mClassDesc').innerText = desc;
        document.getElementById('mClassCalories').innerText = calories;
        document.getElementById('mClassAudience').innerText = audience;
        document.getElementById('mClassBenefits').innerText = benefits;
        var myModal = new bootstrap.Modal(document.getElementById('classDetailModal'));
        myModal.show();
    }

    function showTrainerDetail(name, role, exp, certs, bio, specs) {
        document.getElementById('mTrainerName').innerText = name;
        document.getElementById('mTrainerRole').innerText = role;
        document.getElementById('mTrainerExp').innerText = exp + ' Năm Kinh Nghiệm';
        document.getElementById('mTrainerCerts').innerText = certs;
        document.getElementById('mTrainerBio').innerText = bio;
        document.getElementById('mTrainerSpecs').innerText = specs;
        var myModal = new bootstrap.Modal(document.getElementById('trainerDetailModal'));
        myModal.show();
    }

    function selectPackage(packageName) {
        var select = document.getElementById('selectedClassSelect');
        if (select) {
            select.value = packageName;
        }
    }

    function calculateBMI() {
        var h = parseFloat(document.getElementById('bmiHeight').value);
        var w = parseFloat(document.getElementById('bmiWeight').value);
        var age = parseFloat(document.getElementById('bmiAge').value) || 25;
        var isMale = document.getElementById('bmiMale').checked;

        if (!h || !w || h <= 0 || w <= 0) {
            alert('Vui lòng nhập chiều cao và cân nặng hợp lệ!');
            return;
        }
        var m = h / 100;
        var bmi = (w / (m * m)).toFixed(1);
        
        // Calculate estimated body fat %: (1.20 * BMI) + (0.23 * Age) - (10.8 * Gender) - 5.4 (Gender: male=1, female=0)
        var genderFactor = isMale ? 1 : 0;
        var bodyFat = ((1.20 * bmi) + (0.23 * age) - (10.8 * genderFactor) - 5.4).toFixed(1);
        if (bodyFat < 5) bodyFat = 5.0;

        var box = document.getElementById('bmiResultBox');
        var val = document.getElementById('bmiVal');
        var fatVal = document.getElementById('bmiFatVal');
        var status = document.getElementById('bmiStatus');
        var advice = document.getElementById('bmiAdvice');
        
        box.classList.remove('d-none');
        val.innerText = bmi;
        fatVal.innerText = bodyFat + '%';
        
        var genderText = isMale ? 'Nam' : 'Nữ';

        if (bmi < 18.5) {
            status.innerHTML = '<span class="text-warning"><i class="fas fa-exclamation-triangle me-1"></i> THỂ TRẠNG GẦY / THIẾU CÂN (' + genderText + ' ' + age + ' tuổi)</span>';
            advice.innerText = 'Lời khuyên HLV: Bạn nên chọn các lớp Body Building + Fitness kết hợp dinh dưỡng tăng cân để xây dựng khối lượng cơ bắp.';
        } else if (bmi >= 18.5 && bmi < 25) {
            status.innerHTML = '<span class="text-success"><i class="fas fa-check-circle me-1"></i> THỂ TRẠNG LÝ TƯỞNG / CÂN ĐỐI (' + genderText + ' ' + age + ' tuổi)</span>';
            advice.innerText = 'Lời khuyên HLV: Thể trạng tuyệt vời! Hãy tham gia các lớp MMA Thực Chiến hoặc Muay Thái để tăng tốc độ phản xạ và thể lực bùng nổ.';
        } else if (bmi >= 25 && bmi < 30) {
            status.innerHTML = '<span class="text-danger"><i class="fas fa-weight-scale me-1"></i> THỂ TRẠNG THỪA CÂN (' + genderText + ' ' + age + ' tuổi)</span>';
            advice.innerText = 'Lời khuyên HLV: Bạn nên chọn các lớp Boxing Chuyên Sâu + Cycling Đạp Xe để đốt 800-1000 kcal/buổi và săn chắc vóc dáng.';
        } else {
            status.innerHTML = '<span class="text-danger fw-black"><i class="fas fa-circle-exclamation me-1"></i> THỂ TRẠNG BÉO PHÌ (' + genderText + ' ' + age + ' tuổi)</span>';
            advice.innerText = 'Lời khuyên HLV: Nên đăng ký gói HLV Cá Nhân (PT 1-1) để được theo sát chế độ ăn kiêng và lộ trình giảm mỡ an toàn.';
        }
    }
</script>
}
