                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-sm text-white-50">2. Chọn Gói tập / Lớp học cụ thể *</label>
                            <select asp-for="RegisterForm.SelectedClass" class="form-select bg-dark text-white border-secondary" id="selectedClassSelect">
                                <optgroup label="--- GÓI TẬP MEMBERSHIP TÍCH HỢP ---" id="optGroupPackages">
                                    <option value="Gói 3 Tháng">Gói 3 Tháng (2.990.000đ - Tiết kiệm)</option>
                                    <option value="Gói 6 Tháng">Gói 6 Tháng (4.990.000đ - Tặng găng Boxing)</option>
