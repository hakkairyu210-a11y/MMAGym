                                </optgroup>
                                <optgroup label="--- CÁC LỚP HỌC VÕ THUẬT & FITNESS ---" id="optGroupClasses">
                                    <option value="MMA - Mixed Martial Arts">MMA - Mixed Martial Arts (Thực chiến đỉnh cao)</option>
                                    <option value="Boxing Chuyên Sâu">Boxing Chuyên Sâu (Phản xạ & Đập mỡ)</option>
                                    <option value="Muay Thái Võ Thuật">Muay Thái Võ Thuật (Uy lực chỏ gối)</option>
                                    <option value="Fitness & Body Building">Fitness & Body Building (Tăng cơ giảm mỡ)</option>
                                    <option value="Yoga Ấn Độ">Yoga Ấn Độ (Cân bằng & dẻo dai)</option>
                                </optgroup>
                            </select>
                        </div>

                        <!-- Trainer and Schedule Selection -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label text-sm text-white-50">3. Chọn Huấn Luyện Viên Phụ Trách</label>
                                <select asp-for="RegisterForm.SelectedTrainer" class="form-select bg-dark text-white border-secondary">
                                    <option value="Văn Bá Huyên (Senior Coach)">Văn Bá Huyên (Senior MMA Coach)</option>
                                    <option value="Nguyễn Văn Khoa (Boxing Head Coach)">Nguyễn Văn Khoa (Boxing Head Coach)</option>
                                    <option value="Dương Hữu Trường (Body Builder)">Dương Hữu Trường (Body Builder)</option>
                                    <option value="Phạm Xuân Quốc Huy (Yoga Master)">Phạm Xuân Quốc Huy (Yoga Master)</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-sm text-white-50">4. Chọn Ca Học Trong Tuần</label>
                                <select asp-for="RegisterForm.SelectedScheduleSlot" class="form-select bg-dark text-white border-secondary">
                                    <option value="Thứ 2, 4, 6 - Ca Tối 18:00 PM">Thứ 2, 4, 6 - Ca Tối (18:00 PM - 19:30 PM)</option>
                                    <option value="Thứ 2, 4, 6 - Ca Sáng 09:00 AM">Thứ 2, 4, 6 - Ca Sáng (09:00 AM - 10:30 AM)</option>
                                    <option value="Thứ 3, 5, 7 - Ca Tối 18:00 PM">Thứ 3, 5, 7 - Ca Tối (18:00 PM - 19:30 PM)</option>
                                    <option value="Thứ 3, 5, 7 - Ca Sáng 09:00 AM">Thứ 3, 5, 7 - Ca Sáng (09:00 AM - 10:30 AM)</option>
                                </select>
                            </div>
                        </div>

                        <!-- Payment Method Selection -->
                        <div class="mb-4">
                            <label class="form-label text-sm text-white-50 d-block">5. Chọn Hình Thức Thanh Toán *</label>
                            <div class="row g-2">
                                <div class="col-6">
                                    <input type="radio" class="btn-check" name="RegisterForm.PaymentMethod" id="payMomo" value="MomoOnline" checked>
                                    <label class="btn btn-outline-danger btn-sm w-100 p-2 text-start text-xs border-secondary text-white" for="payMomo">
                                        <i class="fas fa-qrcode text-danger me-1 fs-6"></i> <strong>Thanh toán Online (VietQR)</strong><br>
                                        <span class="text-white-50 text-xxs">Quét QR Ngân hàng / Momo</span>
                                    </label>
                                </div>
                                <div class="col-6">
                                    <input type="radio" class="btn-check" name="RegisterForm.PaymentMethod" id="payCash" value="TienMat">
                                    <label class="btn btn-outline-danger btn-sm w-100 p-2 text-start text-xs border-secondary text-white" for="payCash">
                                        <i class="fas fa-money-bill-wave text-success me-1 fs-6"></i> <strong>Tiền mặt tại quầy</strong><br>
                                        <span class="text-white-50 text-xxs">Thanh toán khi tới phòng tập</span>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-danger w-100 py-3 text-uppercase fw-bold fs-6 shadow-lg">
                            <i class="fas fa-check-circle me-2"></i> Xác Nhận Đăng Ký & Quét Mã Thanh Toán
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

