@model List<MMA.Models.RegisterViewModel>
@{
    ViewData["Title"] = "Thẻ Tập Của Tôi & Gói Đăng Ký - MMA Sài Gòn";
}

<!-- Entry Banner Section -->
<section class="entry-banner">
    <div class="container">
        <h1 class="entry-title">Thẻ Tập Của Tôi</h1>
        <div class="breadcrumb-area">
            <a href="/">Trang Chủ</a>
            <span class="dvdr">-</span>
            <span class="current-item">Gói Tập Đã Đăng Ký</span>
        </div>
    </div>
</section>

<!-- Main Profile & Packages Section -->
<section class="section-padding bg-black text-white">
    <div class="container">
        <div class="row g-4">
            <!-- Sidebar User Card -->
            <div class="col-lg-4">
                <div class="card bg-dark border-secondary border-opacity-25 rounded-4 p-4 text-center shadow-lg">
                    <div class="position-relative d-inline-block mx-auto mb-3">
                        <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=200&auto=format&fit=crop&q=80" class="rounded-circle border border-3 border-danger p-1" style="width: 110px; height: 110px; object-fit: cover;" alt="Member Avatar">
                        <span class="position-absolute bottom-0 end-0 badge bg-success p-2 rounded-circle border border-2 border-dark" title="Đang hoạt động"></span>
                    </div>
                    <h4 class="fw-bold text-white mb-1">@(ViewBag.UserName ?? "Hội Viên MMA Sài Gòn")</h4>
                    <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-50 px-3 py-1 rounded-pill mb-3">@(ViewBag.UserRole ?? "Hội Viên Thẻ VIP")</span>
                    
                    <div class="p-3 bg-black rounded-3 text-start border border-secondary border-opacity-25 text-xs mb-3">
                        <div class="mb-2"><i class="fas fa-envelope text-danger me-2"></i>Email: <strong class="text-white">@(ViewBag.UserEmail ?? "Chưa cập nhật")</strong></div>
                        <div class="mb-2"><i class="fas fa-phone text-danger me-2"></i>Số điện thoại: <strong class="text-white">@(ViewBag.UserPhone ?? "Chưa cập nhật")</strong></div>
                        <div><i class="fas fa-shield-halved text-danger me-2"></i>Trạng thái tài khoản: <strong class="text-success">Tài Khoản Đã Kích Hoạt</strong></div>
                    </div>

                    <a href="/#register-section" class="btn btn-outline-danger btn-sm w-100 fw-bold py-2 text-uppercase">
                        <i class="fas fa-plus me-1"></i> Đăng Ký Thêm Gói Tập Mới
                    </a>
                </div>
            </div>

            <!-- Package Cards & History -->
            <div class="col-lg-8">
                @if (TempData["UserSuccess"] != null)
                {
                    <div class="alert alert-success bg-success bg-opacity-25 text-white border border-success border-opacity-50 rounded-3 mb-4">
                        <i class="fas fa-check-circle me-2"></i>@TempData["UserSuccess"]
                    </div>
                }
                @if (TempData["UserError"] != null)
                {
                    <div class="alert alert-danger bg-danger bg-opacity-25 text-white border border-danger border-opacity-50 rounded-3 mb-4">
                        <i class="fas fa-exclamation-triangle me-2"></i>@TempData["UserError"]
                    </div>
                }

                <div class="card bg-dark border-secondary border-opacity-25 rounded-4 p-4 shadow-lg mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="fw-bold text-white mb-0"><i class="fas fa-address-card text-danger me-2"></i>Danh Sách Gói Tập & Thẻ Membership Của Bạn</h4>
                        <span class="badge bg-secondary">Tổng cộng: @Model.Count gói</span>
                    </div>

                    @if (Model != null && Model.Any())
                    {
                        <div class="d-flex flex-column gap-3">
                            @foreach (var pkg in Model)
                            {
                                bool isCanceled = pkg.Status.Contains("Hủy") || pkg.Status.Contains("hủy");
                                <div class="card bg-black border-secondary border-opacity-25 rounded-4 p-4 hover-border-danger transition-all @(isCanceled ? "opacity-75" : "")">
                                    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 pb-3 border-bottom border-secondary border-opacity-25">
                                        <div>
                                            <span class="text-white-50 text-xs">Mã Thẻ / Hóa Đơn:</span>
                                            <span class="font-monospace text-danger fw-bold ms-1 fs-6">@pkg.InvoiceCode</span>
                                        </div>
                                        <div>
                                            @if (isCanceled)
                                            {
                                                <span class="badge bg-secondary bg-opacity-50 text-light border border-secondary px-3 py-1.5 rounded-pill fs-7"><i class="fas fa-ban me-1"></i> @pkg.Status</span>
                                            }
                                            else if (pkg.IsApproved)
                                            {
                                                <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50 px-3 py-1.5 rounded-pill fs-7"><i class="fas fa-check-circle me-1"></i> Đã Thanh Toán & Đang Hoạt Động</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-50 px-3 py-1.5 rounded-pill fs-7"><i class="fas fa-clock me-1"></i> Chờ Admin Xác Nhận Thanh Toán</span>
                                            }
                                        </div>
                                    </div>

                                    <div class="row g-3 align-items-center">
                                        <div class="col-md-7">
                                            <h4 class="fw-bold text-white mb-2">@pkg.SelectedClass</h4>
                                            <div class="text-xs text-white-50 mb-1"><i class="fas fa-building text-danger me-2"></i>Chi nhánh: <strong class="text-white">@pkg.BranchName</strong></div>
                                            <div class="text-xs text-white-50 mb-1"><i class="fas fa-user-ninja text-warning me-2"></i>Huấn luyện viên: <strong class="text-info">@pkg.SelectedTrainer</strong></div>
                                            <div class="text-xs text-white-50"><i class="fas fa-calendar-week text-success me-2"></i>Lịch tập: <strong class="text-success">@pkg.SelectedScheduleSlot</strong></div>
                                        </div>
                                        <div class="col-md-5 text-md-end">
                                            <div class="text-white-50 text-xs mb-1">Học phí gói tập:</div>
                                            <div class="display-6 fw-black text-danger mb-2">@pkg.Amount.ToString("N0") <span class="fs-6 text-white-50">đ</span></div>
                                            <div class="text-xs text-white-50 mb-3">Thanh toán: <strong>@pkg.PaymentMethod</strong></div>

                                            @if (!isCanceled)
                                            {
                                                <div class="d-flex gap-2 justify-content-md-end">
                                                    @if (!pkg.IsApproved)
                                                    {
                                                        <button type="button" class="btn btn-warning btn-sm text-dark fw-bold text-xs shadow-sm" onclick="alert('Đơn hàng đang chờ Admin xác nhận đã nhận tiền. Thẻ tập sẽ kích hoạt sau khi xác nhận!')">
                                                            <i class="fas fa-clock me-1"></i> Đang Xử Lý
                                                        </button>
                                                    }
                                                    <button type="button" class="btn btn-outline-danger btn-sm text-xs fw-bold" data-bs-toggle="modal" data-bs-target="#cancelModal_@pkg.OrderId">
                                                        <i class="fas fa-times-circle me-1"></i> Hủy Gói Tập
                                                    </button>
                                                </div>

                                                <!-- Modal Xác Nhận Hủy Gói -->
                                                <div class="modal fade text-start" id="cancelModal_@pkg.OrderId" tabindex="-1">
                                                    <div class="modal-dialog modal-dialog-centered">
                                                        <div class="modal-content modal-content-dark">
                                                            <div class="modal-header modal-header-dark py-3">
                                                                <h5 class="modal-title fw-bold text-white"><i class="fas fa-exclamation-circle text-danger me-2"></i>Xác Nhận Hủy Đăng Ký Gói Tập</h5>
                                                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                            </div>
                                                            <div class="modal-body p-4">
                                                                <p class="text-white mb-2">Bạn có chắc chắn muốn hủy gói tập <strong class="text-danger">@pkg.SelectedClass</strong> (Mã đơn: <span class="font-monospace text-warning">@pkg.InvoiceCode</span>)?</p>
                                                                <p class="text-white-50 text-xs mb-0"><i class="fas fa-info-circle text-info me-1"></i>Sau khi hủy, thẻ tập của bạn sẽ ngưng kích hoạt trên hệ thống.</p>
                                                            </div>
                                                            <div class="modal-footer modal-footer-dark">
                                                                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
                                                                <form asp-controller="Account" asp-action="CancelPackage" method="POST">
                                                                    <input type="hidden" name="orderId" value="@pkg.OrderId" />
                                                                    <button type="submit" class="btn btn-danger btn-sm fw-bold px-3">Xác Nhận Hủy Gói</button>
                                                                </form>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-box-open fs-1 text-white-50 mb-3 d-block"></i>
                            <h5 class="text-white fw-bold">Bạn Chưa Đăng Ký Gói Tập Nào</h5>
                            <p class="text-white-50 text-xs mb-4">Hãy chọn gói tập phù hợp để bắt đầu hành trình rèn luyện sức khỏe & võ thuật!</p>
                            <a href="/#register-section" class="btn btn-danger text-uppercase fw-bold px-4 py-2">Đăng Ký Ngay</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
