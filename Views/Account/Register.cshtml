@model MMA.Models.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký tài khoản hội viên - MMA Sài Gòn";
}

<style>
    /* Hide native browser password eye button to prevent 2 eye icons */
    input[type="password"]::-ms-reveal,
    input[type="password"]::-ms-clear,
    input[type="password"]::-webkit-contacts-auto-fill-button,
    input[type="password"]::-webkit-credentials-auto-fill-button {
        display: none !important;
        width: 0 !important;
        height: 0 !important;
    }
</style>

<section class="section-padding bg-dark text-white min-vh-100 d-flex align-items-center auth-section">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8 col-sm-12">
                <div class="auth-card p-4 p-md-5 rounded-4 shadow-lg border border-secondary border-opacity-25 bg-dark-glass">
                    <div class="text-center mb-4">
                        <div class="auth-logo-badge mb-3 mx-auto rounded-circle d-flex align-items-center justify-content-center bg-danger text-white fs-3 shadow-lg" style="width: 65px; height: 65px;">
                            <i class="fas fa-user-plus"></i>
                        </div>
                        <h2 class="fw-black text-uppercase text-white mb-1">Đăng Ký Tài Khoản Hội Viên</h2>
                        <p class="text-muted text-sm">Tạo tài khoản CSDL để đăng ký các gói tập MMA & Fitness</p>
                    </div>

                    <form asp-controller="Account" asp-action="Register" method="POST">
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label text-sm fw-semibold text-light">Họ và Tên *</label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark text-white-50 border-secondary border-opacity-50"><i class="fas fa-user"></i></span>
                                <input asp-for="Name" class="form-control bg-dark text-white border-secondary border-opacity-50" placeholder="Ví dụ: Nguyễn Hùng Mạnh" required>
                            </div>
                            <span asp-validation-for="Name" class="field-validation-error text-danger text-xs mt-1 d-block"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label text-sm fw-semibold text-light">Địa chỉ Gmail / Email *</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-dark text-white-50 border-secondary border-opacity-50"><i class="fas fa-envelope"></i></span>
                                    <input asp-for="Email" class="form-control bg-dark text-white border-secondary border-opacity-50" placeholder="user@gmail.com" required>
                                </div>
                                <span asp-validation-for="Email" class="field-validation-error text-danger text-xs mt-1 d-block"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label text-sm fw-semibold text-light">Số điện thoại *</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-dark text-white-50 border-secondary border-opacity-50"><i class="fas fa-phone"></i></span>
                                    <input asp-for="Phone" class="form-control bg-dark text-white border-secondary border-opacity-50" placeholder="0947054075" required>
                                </div>
                                <span asp-validation-for="Phone" class="field-validation-error text-danger text-xs mt-1 d-block"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label text-sm fw-semibold text-light">Mật khẩu tài khoản *</label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark text-white-50 border-secondary border-opacity-50"><i class="fas fa-key"></i></span>
                                <input name="Password" type="password" class="form-control bg-dark text-white border-secondary border-opacity-50" placeholder="Tạo mật khẩu đăng nhập" required id="regPasswordInput">
                                <button type="button" class="btn btn-outline-secondary border-secondary border-opacity-50 text-white-50 px-3" onclick="toggleRegPassword()" title="Hiện/Ẩn mật khẩu">
                                    <i class="fas fa-eye" id="regEyeIcon"></i>
                                </button>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-danger w-100 py-3 text-uppercase fw-bold shadow-lg tracking-wider mb-4 fs-6">
                            <i class="fas fa-user-check me-2"></i> Xác Nhận Đăng Ký Tài Khoản
                        </button>
                    </form>

                    <div class="text-center text-sm text-white-50 pt-3 border-top border-secondary border-opacity-25">
                        Đã có tài khoản hội viên? 
                        <a href="/dang-nhap" class="text-danger fw-bold text-decoration-none ms-1">Đăng nhập ngay</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    function toggleRegPassword() {
        var pwdInput = document.getElementById('regPasswordInput');
        var eyeIcon = document.getElementById('regEyeIcon');

        if (pwdInput.type === "password") {
            pwdInput.type = "text";
            eyeIcon.classList.remove("fa-eye");
            eyeIcon.classList.add("fa-eye-slash");
            eyeIcon.classList.add("text-danger");
        } else {
            pwdInput.type = "password";
            eyeIcon.classList.remove("fa-eye-slash");
            eyeIcon.classList.remove("text-danger");
            eyeIcon.classList.add("fa-eye");
        }
    }
</script>
