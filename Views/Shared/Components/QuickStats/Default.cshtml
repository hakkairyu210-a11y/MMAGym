@model MMA.ViewComponents.QuickStatsModel

<div class="quick-stats-view-component bg-dark text-white p-4 rounded-4 shadow-sm border border-secondary border-opacity-25 my-4">
    <div class="row g-3 text-center">
        <div class="col-6 col-md-3">
            <div class="p-3 bg-black rounded-3">
                <i class="fas fa-users text-danger fs-3 mb-2"></i>
                <h3 class="fw-bold text-white mb-0">@Model.ActiveMembers+</h3>
                <span class="text-xs text-white-50 text-uppercase">Hội Viên Hoạt Động</span>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="p-3 bg-black rounded-3">
                <i class="fas fa-building text-warning fs-3 mb-2"></i>
                <h3 class="fw-bold text-white mb-0">@Model.TotalBranches</h3>
                <span class="text-xs text-white-50 text-uppercase">Chi Nhánh Sài Gòn</span>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="p-3 bg-black rounded-3">
                <i class="fas fa-user-ninja text-info fs-3 mb-2"></i>
                <h3 class="fw-bold text-white mb-0">@Model.TotalTrainers</h3>
                <span class="text-xs text-white-50 text-uppercase">HLV Quốc Gia</span>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="p-3 bg-black rounded-3">
                <i class="fas fa-star text-success fs-3 mb-2"></i>
                <h3 class="fw-bold text-white mb-0">@Model.SatisfiedRate%</h3>
                <span class="text-xs text-white-50 text-uppercase">Hài Lòng Kết Quả</span>
            </div>
        </div>
    </div>
</div>
